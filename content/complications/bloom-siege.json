{
  "id": "BloomSiege",
  "name": "Bloom Siege",
  "description": "The Bloom has become aggressive, actively sieging settlements and blocking major routes. Towns are fortified, but supplies are running low.",
  "evidenceChain": [
    "bloom_barricade_reports",
    "siege_breach_map",
    "fortified_town_census",
    "supply_convoy_losses",
    "spore_wall_samples",
    "evacuation_orders",
    "bloom_tide_timeline",
    "defender_casualty_list",
    "sealed_gate_logs",
    "ration_ledger",
    "bloom_growth_survey",
    "refugee_testimony",
    "perimeter_failure_notice",
    "instigator_spore_cache",
    "siege_master_orders"
  ],
  "worldStateModifiers": {
    "routeStatusChance": {
      "bloomAffected": 0.4,
      "blocked": 0.2
    },
    "townEffects": {
      "supplyShortage": true,
      "vendorPriceMultiplier": 1.5,
      "recruitCostMultiplier": 1.3
    },
    "travelEffects": {
      "encounterChanceBonus": 0.15,
      "bloomEnemyWeight": 3
    },
    "reputationEffects": {
      "bureau": -2,
      "convocation": -2
    }
  },
  "events": [
    {
      "id": "siege_begins",
      "name": "Siege Begins",
      "description": "Bloom creatures have surrounded the outer settlements.",
      "turnThreshold": 3,
      "effect": "block_routes",
      "routeCount": 2
    },
    {
      "id": "supply_crisis",
      "name": "Supply Crisis",
      "description": "Trade routes are cut. Prices have skyrocketed.",
      "turnThreshold": 6,
      "effect": "price_increase",
      "multiplier": 1.5
    },
    {
      "id": "breakout_attempt",
      "name": "Breakout Attempt",
      "description": "The Bureau leads a breakout attempt. Volunteers needed.",
      "turnThreshold": 10,
      "effect": "reputation_change",
      "reputationDelta": 5,
      "targetFaction": "bureau"
    }
  ]
}
