      "turnThreshold": 3,
      "effect": "block_routes",
      "routeCount": 1
    },
    {
      "id": "routes_warped",
      "name": "Routes Warped",
      "description": "Multiple travel routes have rearranged. Maps are becoming unreliable.",
      "turnThreshold": 7,
      "effect": "contest_routes",
      "routeCount": 2
    },
    {
      "id": "engine_critical",
      "name": "Engine Critical",
      "description": "The Engine's output is spiking. Dungeons may begin rearranging themselves in real time.",
      "turnThreshold": 12,
      "effect": "world_state_change",
      "worldStateKey": "engine_status",
      "worldStateValue": "critical"
    }
  ]
}
