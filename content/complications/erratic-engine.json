{
  "id": "ErraticEngine",
  "name": "Erratic Engine",
  "description": "One of the ancient Engines has become dangerously unstable, causing dungeon geometry to shift and rearrange unpredictably. No corridor can be trusted.",
  "evidenceChain": [
    "power_surge_logs",
    "engine_misfire_reports",
    "fried_conduit_samples",
    "blackout_grid_map",
    "governor_tamper_marks",
    "overheated_core_warnings",
    "engineer_panic_notes",
    "rolling_outage_schedule",
    "harmonic_distortion_readings",
    "backup_failure_record",
    "coolant_loss_ledger",
    "control_room_lockout",
    "saboteur_tool_cache",
    "tuning_fork_signature",
    "engine_breaker_orders"
  ],
  "worldStateModifiers": {
