      "engineAffected": 0.3,
      "blocked": 0.1
    },
    "townEffects": {
      "engineResearchNeeded": true,
      "vendorComponentPriceMultiplier": 1.2
    },
    "travelEffects": {
      "encounterChanceBonus": 0.1,
      "engineHazardWeight": 2
    },
    "reputationEffects": {
      "convocation": -2,
      "cartography": -1
    }
  },
  "events": [
    {
      "id": "first_shift",
      "name": "First Shift Detected",
