      "turnThreshold": 6,
      "effect": "tithe_devaluation",
      "tokenMultiplier": 0.5
    },
    {
      "id": "stabilization_effort",
      "name": "Stabilization Effort",
      "description": "The Bureau is attempting to stabilize the Tithe network. Aid them?",
      "turnThreshold": 12,
      "effect": "reputation_change",
      "reputationDelta": 5,
      "targetFaction": "bureau"
    }
  ]
